# Copy to .env and fill in. Never commit .env.
# 'development' allows an empty API_TOKEN. Any other value requires a token of 32+ characters
# (generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))")
APP_ENV=development
API_TOKEN=
DATABASE_URL=sqlite:///./marketpulse.db
FINNHUB_API_KEY=
TWELVEDATA_API_KEY=
# Comma-separated list of origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
# Trusted reverse proxies in front of the API (0 = none; 1 on Render). Needed for correct per-client rate limiting.
PROXY_HOPS=0

# Optional: email when a ticker's band flips. Leave SMTP_HOST empty to disable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
